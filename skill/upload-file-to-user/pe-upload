#!/usr/bin/env bash
# pe-upload <file> [name] — upload a file, print its public URL
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: pe-upload <file> [name]" >&2; exit 1; }
: "${PRIVATEEYES_TOKEN:?set PRIVATEEYES_TOKEN}"
HOST="${PRIVATEEYES_HOST:-http://ubuntu-app-prod:8790}"
ARGS=(-sf -F "file=@$1" -H "Authorization: Bearer $PRIVATEEYES_TOKEN")
[ $# -ge 2 ] && ARGS+=(-F "name=$2")
curl "${ARGS[@]}" "$HOST/v1/upload" | { command -v jq >/dev/null && jq -r .url || cat; }
